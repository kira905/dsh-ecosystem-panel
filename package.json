{
  "name": "@kira905/dsh-ecosystem-panel",
  "description": "Read-only ecosystem overview panel for a DSH instance: plugin bundles, cordis.patch inserts, patch health, skills, upgrade health and decoupling health. One tab per category. Zero runtime npm dependencies.",
  "version": "0.5.2",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "verify": "node scripts/verify-source.mjs .",
    "test": "node scripts/test-fixture.mjs",
    "test:swr": "node scripts/test-swr.mjs",
    "test:warmup": "node scripts/test-warmup-negctl.mjs",
    "test:singleflight": "node scripts/test-singleflight.mjs",
    "test:degrade": "node scripts/test-degrade.mjs",
    "test:all": "node scripts/test-fixture.mjs && node scripts/test-swr.mjs && node scripts/test-warmup-negctl.mjs && node scripts/test-singleflight.mjs && node scripts/test-degrade.mjs",
    "sim": "node scripts/sim-selfcheck.mjs",
    "state": "node scripts/verify-state.mjs"
  },
  "dependencies": {},
  "keywords": [
    "dsh",
    "plugin",
    "panel",
    "diagnostics",
    "read-only",
    "health-check",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "scripts/**/*.mjs",
    "examples/**",
    "docs/**",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kira905/dsh-ecosystem-panel.git"
  },
  "homepage": "https://github.com/kira905/dsh-ecosystem-panel#readme",
  "bugs": {
    "url": "https://github.com/kira905/dsh-ecosystem-panel/issues"
  }
}
